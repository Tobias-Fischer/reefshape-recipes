From: Tobias Fischer <info@tobiasfischer.info>
Date: Tue, 3 Nov 2026 06:54:47 +1000
Subject: [PATCH] SAM on the Apple GPU: device is CUDA, else MPS, else CPU
 (TAGLAB_DEVICE overrides); float32 prompt points for automatic SAM on MPS;
 CPU fallback for nms

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 TagLab.py                      |  3 +++
 source/genutils.py             | 27 +++++++++++++++++++++++++++
 source/tools/SAMInteractive.py |  8 ++++----
 source/tools/Sam.py            | 17 +++++++++--------
 4 files changed, 43 insertions(+), 12 deletions(-)

diff --git a/TagLab.py b/TagLab.py
index f118f5e..7ebcf63 100644
--- a/TagLab.py
+++ b/TagLab.py
@@ -20,6 +20,9 @@
 
 import sys
 import os
+
+# Apple GPU (MPS): run the few operators it lacks (torchvision nms in automatic SAM) on the CPU. Must be set before torch loads.
+os.environ.setdefault("PYTORCH_ENABLE_MPS_FALLBACK", "1")
 import datetime
 import shutil
 import json
diff --git a/source/genutils.py b/source/genutils.py
index e5e4f5b..4776a0a 100644
--- a/source/genutils.py
+++ b/source/genutils.py
@@ -63,6 +63,33 @@ def modelsDir():
     return path
 
 
+def torchDevice():
+    """
+    Device for the neural networks: CUDA if available, else the Apple GPU (MPS) on Apple-silicon Macs, else the CPU.
+    Set TAGLAB_DEVICE (cpu, mps, cuda) to force one.
+    """
+    import torch
+    forced = os.environ.get("TAGLAB_DEVICE")
+    if forced:
+        return torch.device(forced)
+    if torch.cuda.is_available():
+        return torch.device("cuda")
+    mps = getattr(torch.backends, "mps", None)
+    if mps is not None and mps.is_available():
+        return torch.device("mps")
+    return torch.device("cpu")
+
+
+def emptyDeviceCache():
+    """Release cached GPU memory (CUDA or MPS); nothing on the CPU."""
+    import torch
+    if torch.cuda.is_available():
+        torch.cuda.empty_cache()
+    mps = getattr(torch, "mps", None)
+    if mps is not None and torch.backends.mps.is_available():
+        mps.empty_cache()
+
+
 def modelPath(name):
     """ Path of the weights file `name`: an existing file in the models folder or in the TagLab one, else where it would be stored. """
     path = os.path.join(modelsDir(), name)
